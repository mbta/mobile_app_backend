{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":prConcurrentLimit10"
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "manage erlang/elixir/alpine version directly from hexpm docker image",
      "matchDepNames": [
        "erlang",
        "elixir",
        "hexpm/elixir",
        "alpine"
      ],
      "matchManagers": [
        "asdf",
        "dockerfile"
      ],
      "enabled": false
    },
    {
      "description": "propose erlang/elixir/alpine updates at separate levels in parallel",
      "matchDepNames": [
        "erlang",
        "elixir",
        "alpine"
      ],
      "matchManagers": [
        "regex"
      ],
      "separateMajorMinor": true,
      "separateMinorPatch": true,
      "separateMultipleMajor": true,
      "separateMultipleMinor": true
    },
    {
      "description": "group erlang/elixir/alpine patch updates together",
      "matchDepNames": [
        "erlang",
        "elixir",
        "alpine"
      ],
      "matchManagers": [
        "regex"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "runtime (patch)"
    }
  ],
  "customManagers": [
    {
      "description": "erlang in asdf",
      "customType": "regex",
      "managerFilePatterns": [
        ".tool-versions"
      ],
      "matchStrings": [
        "(^|\\n)erlang\\s+(?<currentValue>[\\d.]+)(\\n|$)"
      ],
      "depNameTemplate": "erlang",
      "packageNameTemplate": "hexpm/elixir",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^[\\d.]+-erlang-(?<version>[\\d.]+)-alpine-[\\d.]+$",
      "versioningTemplate": "loose"
    },
    {
      "description": "erlang major version for elixir in asdf",
      "customType": "regex",
      "managerFilePatterns": [
        ".tool-versions"
      ],
      "matchStrings": [
        "-otp-(?<currentValue>\\d+)(\\n|$)"
      ],
      "depNameTemplate": "erlang",
      "packageNameTemplate": "hexpm/elixir",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^[\\d.]+-erlang-(?<version>\\d+)[\\d.]+-alpine-[\\d.]+$",
      "versioningTemplate": "loose"
    },
    {
      "description": "erlang in docker",
      "customType": "regex",
      "managerFilePatterns": [
        "Dockerfile"
      ],
      "matchStrings": [
        "(^|\\n)ARG ERLANG_VERSION=(?<currentValue>[\\d.]+)(\\n|$)"
      ],
      "depNameTemplate": "erlang",
      "packageNameTemplate": "hexpm/elixir",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^[\\d.]+-erlang-(?<version>[\\d.]+)-alpine-[\\d.]+$",
      "versioningTemplate": "loose"
    },
    {
      "description": "elixir in asdf",
      "customType": "regex",
      "managerFilePatterns": [
        ".tool-versions"
      ],
      "matchStrings": [
        "(^|\\n)elixir\\s+(?<currentValue>[\\d.]+)-otp-\\d+(\\n|$)"
      ],
      "depNameTemplate": "elixir",
      "packageNameTemplate": "hexpm/elixir",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^(?<version>[\\d.]+)-erlang-[\\d.]+-alpine-[\\d.]+$",
      "versioningTemplate": "semver"
    },
    {
      "description": "elixir in docker",
      "customType": "regex",
      "managerFilePatterns": [
        "Dockerfile"
      ],
      "matchStrings": [
        "(^|\\n)ARG ELIXIR_VERSION=(?<currentValue>[\\d.]+)(\\n|$)"
      ],
      "depNameTemplate": "elixir",
      "packageNameTemplate": "hexpm/elixir",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^(?<version>[\\d.]+)-erlang-[\\d.]+-alpine-[\\d.]+$",
      "versioningTemplate": "semver"
    },
    {
      "description": "alpine in docker",
      "customType": "regex",
      "managerFilePatterns": [
        "Dockerfile"
      ],
      "matchStrings": [
        "(^|\\n)ARG ALPINE_VERSION=(?<currentValue>[\\d.]+)(\\n|$)"
      ],
      "depNameTemplate": "alpine",
      "packageNameTemplate": "hexpm/elixir",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^[\\d.]+-erlang-[\\d.]+-alpine-(?<version>[\\d.]+)$",
      "versioningTemplate": "semver"
    }
  ],
  "constraints": {
    "erlang": ">=28.5"
  }
}
