#. Assemble a summary of an alert with the structure:
#. [This trip] [will not stop at  stop A][ due to maintenance][ daily until friday]
#. Alert summary in the format of “[trip identity] [is affected][due to cause][until recurrence]”, ex “[12:13 PM from Ruggles] [is cancelled today][ due to a mechanical issue][ some days until Wednesday]” or “[Multiple trips] [are suspended today][][]”
#: lib/mobile_app_backend/alerts/formatted_alert/templates.ex:197
#, elixir-autogen, elixir-format
msgid "%{trip_identity} %{skipped_effect}%{cause}%{recurrence}"
msgstr "%{trip_identity} %{skipped_effect}%{cause}%{recurrence}"

#. Assemble a summary of an alert with the structure:
#. [This trip] affected by [detour] [today][ due to maintenance][ daily until friday]
#: lib/mobile_app_backend/alerts/formatted_alert/templates.ex:300
#, elixir-autogen, elixir-format
msgid "%{trip_identity} affected by %{effect} %{timeframe}%{cause}%{recurrence}"
msgstr "%{trip_identity} est perturbé par %{effect} %{timeframe}%{cause}%{recurrence}"

#. Assemble a summary of an alert with the structure:
#. [These trips] are cancelled [today][ due to maintenance][ daily until friday]
#: lib/mobile_app_backend/alerts/formatted_alert/templates.ex:163
#, elixir-autogen, elixir-format
msgid "%{trip_identity} are cancelled %{timeframe}%{cause}%{recurrence}"
msgstr "%{trip_identity} sont annulés %{timeframe}%{cause}%{recurrence}"

#. Assemble a summary of an alert with the structure:
#. [These trips] are suspended [today][ due to maintenance][ daily until friday]
#: lib/mobile_app_backend/alerts/formatted_alert/templates.ex:246
#, elixir-autogen, elixir-format
msgid "%{trip_identity} are suspended %{timeframe}%{cause}%{recurrence}"
msgstr "%{trip_identity} sont suspendus %{timeframe}%{cause}%{recurrence}"

#. Assemble a summary of an alert with the structure:
#. [Trip 101] experiencing delays[ of about 10 minutes][ today][ due to maintenance][ daily until Friday]
#: lib/mobile_app_backend/alerts/formatted_alert/templates.ex:278
#, elixir-autogen, elixir-format
msgid "%{trip_identity} experiencing delays%{delay_duration} %{timeframe}%{cause}%{recurrence}"
msgstr "%{trip_identity} connaît des retards%{delay_duration} %{timeframe}%{cause}%{recurrence}"

#. Assemble a summary of an alert with the structure:
#. [This trip] is cancelled [today][ due to maintenance][ daily until friday]
#: lib/mobile_app_backend/alerts/formatted_alert/templates.ex:174
#, elixir-autogen, elixir-format
msgid "%{trip_identity} is cancelled %{timeframe}%{cause}%{recurrence}"
msgstr "%{trip_identity} est annulé %{timeframe}%{cause}%{recurrence}"

#. Assemble a summary of an alert with the structure:
#. [This trip] is suspended [today][ due to maintenance][ daily until friday]
#: lib/mobile_app_backend/alerts/formatted_alert/templates.ex:257
#, elixir-autogen, elixir-format
msgid "%{trip_identity} is suspended %{timeframe}%{cause}%{recurrence}"
msgstr "%{trip_identity} est suspendu %{timeframe}%{cause}%{recurrence}"

#. Assemble a summary of an alert with the structure:
#. [This trip] will terminate at [Porter][ today][ due to maintenance][ daily until friday]
#: lib/mobile_app_backend/alerts/formatted_alert/templates.ex:221
#, elixir-autogen, elixir-format
msgid "%{trip_identity} will terminate at %{terminating_stop} %{timeframe}%{cause}%{recurrence}"
msgstr "%{trip_identity} se terminera à %{terminating_stop} %{timeframe}%{cause}%{recurrence}"

