#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:28
#, elixir-autogen, elixir-format
#. Alert summary location for a single stop in the format of " at [Stop name]" ex. " at [Haymarket]" or " at [Green St @ Magazine St]". The leading space should be retained for interpolation into a full alert summary template.
msgid " at **%{stop_name}**"
msgstr " nan **%{stop_name}**"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:104
#, elixir-autogen, elixir-format
#. Alert summary recurrence every day until the indicated date, e.g. “ daily[ until Friday]”. The leading space must be retained.
msgid " daily%{recurrence_text}"
msgstr " chak jou%{recurrence_text}"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:164
#, elixir-autogen, elixir-format
#. An alert cause interpolated into an alert summary: ex. "due to [maintenance]", in a longer string like "Trip 101 experiencing delays of about 10 minutes today due to maintenance daily until Friday"
msgid " due to %{cause}"
msgstr " akòz %{cause}"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:221
#, elixir-autogen, elixir-format
#. Alert summary timeframe with a range today that will recur in the future, e.g. “from 9:00 PM to end of service”. The leading space should be retained.
msgid " from %{start_time} to %{end_time}"
msgstr " soti nan %{start_time} rive nan %{end_time}"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:22
#, elixir-autogen, elixir-format
#. Alert summary location for branching routes in the format of " from [direction] stops to [Stop name]" ex. " from [Westbound] stops to [Kenmore]" or " from [Eastbound] stops to [Government Center]". The leading space should be retained for interpolation into a full alert summary template.
msgid " from **%{direction_name}** stops to **%{end_stop_name}**"
msgstr " soti nan **%{direction_name}** sispann rive nan **%{end_stop_name}**"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:37
#, elixir-autogen, elixir-format
#. Alert summary location for consecutive stops in the format of " from [Stop name] to [Other stop name]" ex. " from [Alewife] to [Harvard]" or " from [Lechmere] to [Park Street]". The leading space should be retained for interpolation into a full alert summary template.
msgid " from **%{start_stop}** to **%{end_stop}**"
msgstr " soti nan **%{start_stop}** a **%{end_stop}**"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:31
#, elixir-autogen, elixir-format
#. Alert summary location for branching routes in the format of " from [Stop name] to [direction] stops" ex. " from [Kenmore] to [Westbound] stops" or " from [JFK/UMass] to [Southbound] stops". The leading space should be retained for interpolation into a full alert summary template.
msgid " from **%{stop_name}** to **%{direction_name}** stops"
msgstr " soti nan **%{stop_name}** rive nan **%{direction_name}** sispann"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:48
#, elixir-autogen, elixir-format
#. Alert summary location for an entire route in the format of " on [RouteLabel]" ex. " on [Green Line C]" or " on [1 bus]". The leading space should be retained for interpolation into a full alert summary template.
msgid " on **%{mode_label}**"
msgstr " sou **%{mode_label}**"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:44
#, elixir-autogen, elixir-format
#. Alert summary location for an entire route with shuttle service in the format of " replacing [RouteLabel]" ex. " replacing [Green Line C]" or " replacing [Orangle Line]". The leading space should be retained for interpolation into a full alert summary template.
msgid " replacing **%{mode_label}**"
msgstr " ranplase **%{mode_label}**"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:113
#, elixir-autogen, elixir-format
#. Alert summary recurrence on only certain days until the indicated date, e.g. “some days until Jan 16”. The leading space must be retained.
msgid " some days%{recurrence_text}"
msgstr " kèk jou%{recurrence_text}"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:216
#, elixir-autogen, elixir-format
#. Alert summary timeframe starting on a specific time later today. ex. " starting 10:00 PM today". The time component is localized by the OS. The leading space should be retained for interpolation into a full alert summary template.
msgid " starting **%{formatted_time}** today"
msgstr " kòmanse **%{formatted_time}** jodi a"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:213
#, elixir-autogen, elixir-format
#. Alert summary timeframe starting tomorrow. The leading space should be retained for interpolation into a full alert summary template.
msgid " starting tomorrow"
msgstr " kòmanse demen"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:183
#, elixir-autogen, elixir-format
#. Alert summary timeframe ending at the end of service on the current day. The leading space should be retained for interpolation into a full alert summary template.
msgid " through end of service"
msgstr " jiska fen sèvis la"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:189
#, elixir-autogen, elixir-format
#. Alert summary timeframe ending tomorrow. The leading space should be retained for interpolation into a full alert summary template.
msgid " through tomorrow"
msgstr " jiska demen"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:127
#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:172
#, elixir-autogen, elixir-format
#. Alert summary timeframe with no known end. The leading space should be retained.
msgid " until further notice"
msgstr " jiskaske yo bay lòt avi"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:130
#, elixir-autogen, elixir-format
#. Alert summary recurrence ending tomorrow. The leading space should be retained.
msgid " until tomorrow"
msgstr " jiska demen"

