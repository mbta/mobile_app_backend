#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:173
#, elixir-autogen, elixir-format
#. Alert summary timeframe ending today at an unspecified time. The leading space should be retained.
msgid " until later today"
msgstr " más tarde hoy"

#: lib/mobile_app_backend/alerts/formatted_alert/templates.ex:46
#, elixir-autogen, elixir-format
#. Text in a notification prompting users to click to learn more
msgid "%{summary}. See alert details."
msgstr "%{summary} a Detalles de la alerta"

#: lib/mobile_app_backend/alerts/formatted_alert/templates.ex:63
#, elixir-autogen, elixir-format
#. Assemble a full summary of an alert with the structure: \n**[Modified service]**[ from Porter to Havard][ starting today][ daily until Friday][ due to maintenance]
msgid "**%{effect_sentence_case}**%{summary_location}%{summary_timeframe}%{summary_recurrence}%{due_to_cause}"
msgstr "**%{effect_sentence_case}**%{summary_location}%{summary_timeframe}%{summary_recurrence}%{due_to_cause}"

#: lib/mobile_app_backend/alerts/formatted_alert/templates.ex:120
#, elixir-autogen, elixir-format
#. Alert summary in the format of \"All clear: Normal service has resumed.\"
msgid "**All clear:** Normal service has resumed."
msgstr "**Todo despejado:** El servicio normal se reanudó."

#: lib/mobile_app_backend/alerts/formatted_alert/templates.ex:111
#, elixir-autogen, elixir-format
#. Alert summary in the format of "Update: [Alert effect] has ended[ at location].", ex "[Update][Stop closure] has ended[ at Haymarket]." or \"[Update][Service suspension] has ended[ from Alewife to Harvard]”.
msgid "**Update:** %{effect_sentence_case} has ended%{summary_location}."
msgstr "**Actualización:** %{effect_sentence_case} terminó%{summary_location}."

#: lib/mobile_app_backend/alerts/formatted_alert/templates.ex:80
#: lib/mobile_app_backend/alerts/formatted_alert/templates.ex:89
#: lib/mobile_app_backend/alerts/formatted_alert/templates.ex:102
#, elixir-autogen, elixir-format
#. Alert summary in the format of "Update: [Vehicle type] service has resumed[ at location].", ex "Update: [Train] service has resumed[ from Riverside to Newton Highlands]." or "Update: [Bus] service has resumed[ at Market St @ Lothrop St]."
msgid "**Update:** %{mode} service has resumed%{summary_location}."
msgstr "**Actualización:** %{mode} servicio se reanudó%{summary_location}."

#: lib/mobile_app_backend/notifications/engine/outgoing_notification.ex:50
#, elixir-autogen, elixir-format
#. Example: “Update: Service has ended”
msgid "Update: %{body}"
msgstr "Actualización: %{body}"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:54
#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:57
#, elixir-autogen, elixir-format
#. Alert summary when there are multiple locations For example "Service suspended at [Downtown Crossing and Oak Grove]" or "Service suspended at [multiple stops]"
msgid " at %{stop_list}"
msgstr " en %{stop_list}"

#: lib/mobile_app_backend/alerts/formatted_alert/template_fragments.ex:69
#, elixir-autogen, elixir-format
#. Alert effect denoting station bypass, ex “will not stop[ at Back Bay and Ruggles] [today]”
msgid "will not stop%{affected_stops_location} %{timeframe}"
msgstr "no se detendrá en%{affected_stops_location} %{timeframe}"

